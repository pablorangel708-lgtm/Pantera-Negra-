--------------------------------------------------------------------
-- SISTEMA DE ENVIO COM PAUSA DE 3 SEGUNDOS
--------------------------------------------------------------------
local ocupado = false
local botoesEnvio = {}
local tokenStatus = 0

local function definirStatus(texto, cor)
	tokenStatus += 1
	status.Text = texto
	status.TextColor3 = cor or COR_TEXTO_FRACO
	return tokenStatus
end

local function atualizarBotoes()
	for _, item in ipairs(botoesEnvio) do
		if ocupado then
			item.botao.BackgroundColor3 = COR_BLOQUEADO
			item.botao.TextTransparency = 0.5
		else
			item.botao.BackgroundColor3 = item.corBase
			item.botao.TextTransparency = 0
		end
	end
end

local function enviar(mensagem)
	if ocupado then
		definirStatus("⏳ Aguarde o intervalo para enviar outra", COR_AVISO)
		return false
	end

	ocupado = true
	atualizarBotoes()

	task.spawn(function()
		local ok, err = pcall(enviarNoChat, mensagem)
		if not ok then
			warn("[PanteraNegra] Falha ao enviar: " .. tostring(err))
		end
	end)

	task.spawn(function()
		local inicio = os.clock()
		local meuToken = definirStatus("⏳ Aguarde " .. COOLDOWN .. "s...", COR_TEXTO_FRACO)
		while true do
			local restante = COOLDOWN - (os.clock() - inicio)
			if restante <= 0 then
				break
			end
			if tokenStatus == meuToken or string.sub(status.Text, 1, 1) == "⏳" then
				status.Text = string.format("⏳ Aguarde %.1fs...", restante)
				status.TextColor3 = COR_TEXTO_FRACO
				meuToken = tokenStatus
			end
			task.wait(0.1)
		end
		ocupado = false
		atualizarBotoes()
		definirStatus("✅ Pronto para enviar", COR_TEXTO_FRACO)
	end)

	return true
end

local function mostrarAviso(texto)
	local meu = definirStatus(texto, COR_AVISO)
	task.delay(2, function()
		if tokenStatus == meu then
			definirStatus(ocupado and "⏳ Aguarde..." or "✅ Pronto para enviar", COR_TEXTO_FRACO)
		end
	end)
end

