local primeiraAbertura = true

local function ajustarPainel()
	local vp = viewport()
	local w = math.min(330, vp.X - 16)
	local h = math.min(440, vp.Y - 90)
	painel.Size = UDim2.fromOffset(w, h)
	if primeiraAbertura then
		primeiraAbertura = false
		painel.Position = UDim2.fromOffset(math.floor((vp.X - w) / 2), math.max(40, math.floor((vp.Y - h) / 2)))
	end
	local x, y = limitar(painel, painel.AbsolutePosition.X, painel.AbsolutePosition.Y)
	if painel.AbsolutePosition.X ~= x or painel.AbsolutePosition.Y ~= y then
		painel.Position = UDim2.fromOffset(x, y)
	end
end

local function alternarPainel()
	if painel.Visible then
		painel.Visible = false
	else
		ajustarPainel()
		painel.Visible = true
		task.defer(ajustarPainel)
	end
end

