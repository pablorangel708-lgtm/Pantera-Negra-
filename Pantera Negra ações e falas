-- ARRASTAR (toque e mouse)
--------------------------------------------------------------------
local function tornarArrastavel(alca, alvo, aoTocar)
	local arrastando = false
	local moveu = false
	local entrada = nil
	local inicioToque = Vector3.zero
	local inicioAlvo = Vector2.zero

	alca.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			arrastando = true
			moveu = false
			entrada = input
			inicioToque = input.Position
			inicioAlvo = alvo.AbsolutePosition
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not arrastando then
			return
		end
		local valido = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == entrada)
		if not valido then
			return
		end
		local delta = input.Position - inicioToque
		if delta.Magnitude > 8 then
			moveu = true
		end
		if moveu then
			local x, y = limitar(alvo, inicioAlvo.X + delta.X, inicioAlvo.Y + delta.Y)
			alvo.Position = UDim2.fromOffset(x, y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if not arrastando then
			return
		end
		if input == entrada or input.UserInputType == Enum.UserInputType.MouseButton1 then
			arrastando = false
			if not moveu and aoTocar then
				aoTocar()
			end
		end
	end)
end

