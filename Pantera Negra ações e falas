--------------------------------------------------------------------
-- UTILIDADES
--------------------------------------------------------------------
local function criar(classe, props, pai)
	local obj = Instance.new(classe)
	for k, v in pairs(props) do
		obj[k] = v
	end
	if pai then
		obj.Parent = pai
	end
	return obj
end

local function arredondar(obj, raio)
	criar("UICorner", {CornerRadius = UDim.new(0, raio)}, obj)
end

local function viewport()
	local cam = workspace.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2.new(400, 700)
end

local function limitar(obj, x, y)
	local vp = viewport()
	local s = obj.AbsoluteSize
	return math.clamp(x, 0, math.max(0, vp.X - s.X)), math.clamp(y, 0, math.max(0, vp.Y - s.Y))
end

local function trim(s)
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

local function precisaNome(texto)
	return string.find(texto, PLACEHOLDER, 1, true) ~= nil
end

