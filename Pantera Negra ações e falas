-- ENVIO PARA O CHAT (TextChatService ou chat legado)
--------------------------------------------------------------------
local function enviarNoChat(mensagem)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local canais = TextChatService:WaitForChild("TextChannels", 5)
		local canal = canais and canais:WaitForChild("RBXGeneral", 5)
		if canal then
			canal:SendAsync(mensagem)
		else
			warn("[PanteraNegra] Canal RBXGeneral não encontrado.")
		end
	else
		local eventos = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
		local say = eventos and eventos:WaitForChild("SayMessageRequest", 5)
		if say then
			say:FireServer(mensagem, "All")
		else
			warn("[PanteraNegra] SayMessageRequest não encontrado.")
		end
	end
end

