local function criarBotaoEnvio(pai, texto, ordem, aoClicar)
	local b = criar("TextButton", {
		BackgroundColor3 = COR_BOTAO,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.Gotham,
		Text = texto,
		TextColor3 = COR_TEXTO,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = ordem,
		AutoButtonColor = true,
	}, pai)
	arredondar(b, 8)
	criar("UIPadding", {
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
		PaddingTop = UDim.new(0, 9),
		PaddingBottom = UDim.new(0, 9),
	}, b)
	table.insert(botoesEnvio, {botao = b, corBase = COR_BOTAO})
	b.Activated:Connect(aoClicar)
	return b
end

local function listaDeAcoes(secao, lista)
	for i, item in ipairs(lista) do
		local titulo, modelo = item[1], item[2]
		criarBotaoEnvio(secao, titulo, i, function()
			local texto = modelo
			if precisaNome(modelo) then
				local nome = trim(campoNome.Text)
				if nome == "" then
					mostrarAviso("⚠️ Digite o nome do personagem")
					return
				end
				texto = string.gsub(modelo, PLACEHOLDER, function()
					return nome
				end)
			end
			enviar(texto)
		end)
	end
end

